{
    "semi": false,
    "singleQuote": true,
    "tabWidth": 4,
    "plugins": ["prettier-plugin-svelte"],
    "overrides": [
        {
            "files": "*.svelte",
            "options": { "parser": "svelte" }
        },
        {
            "files": "*.{yml,yaml}",
            "options": { "tabWidth": 2 }
        }
    ]
}
